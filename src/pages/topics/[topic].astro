---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getPublicArticleGroups } from '../../lib/articles';
import { topicInfo, topicOrder, detailedTopics } from '../../lib/topics';

export async function getStaticPaths() {
  const all = await getPublicArticleGroups();
  const topics = detailedTopics(all);
  const routes = topics.map((topic) => ({ params: { topic: topic.slug }, props: { title: topic.title, groups: topic.groups, legacy: false } }));
  for (const topic of topicOrder) {
    const existing = routes.find((route) => route.params.topic === topic);
    if (existing) {
      const merged = all.filter((group) => group.topic === topic || existing.props.groups.includes(group));
      existing.props.legacy = merged.length > existing.props.groups.length;
      existing.props.groups = merged;
    } else {
      routes.push({ params: { topic }, props: { title: topicInfo[topic].title, groups: all.filter((group) => group.topic === topic), legacy: true } });
    }
  }
  return routes;
}

const { title, groups, legacy } = Astro.props;
---

<BaseLayout title={title}>
  <header class="container page-intro topic-intro">
    <p class="eyebrow">{legacy ? 'Earlier topic index' : 'Topic'} · {groups.length} notes</p>
    <h1>{title}</h1>
    <p>{legacy ? '此索引也保留舊主題中的文章，不代表目前的主要分類。' : '同一個主題，可以出現在不同的人生經驗、資安筆記、專案與研究中。'} <a href="/articles/">Browse Articles →</a></p>
  </header>
  <section class="container topic-index">
    <div class="index-heading">
      <span>Published notes</span>
      <span>Newest first</span>
    </div>
    <ArticleList groups={groups} />
  </section>
</BaseLayout>

<style>
  .topic-index { padding-bottom: var(--space-section); }
  .index-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.8rem;
    color: var(--muted-readable);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
