---
import { withBase } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicArticleGroups } from '../../lib/articles';
import { detailedTopics } from '../../lib/topics';

const groups = await getPublicArticleGroups();
const topics = detailedTopics(groups);
---

<BaseLayout title="Topics">
  <header class="container page-intro">
    <p class="eyebrow">Subjects &amp; threads</p>
    <h1>Topics</h1>
    <p>從 CTF、FRC 到 AI 與醫療，沿著細部主題閱讀。文章的四個主要分類，請見 <a href={withBase('/articles/')}>Articles</a>。</p>
  </header>
  <section class="container topics-section" aria-label="Topics">
    <div class="practice-list">
      {topics.map((topic, index) => (
        <a class="practice-row" href={withBase(`/topics/${topic.slug}/`)}>
          <span class="practice-number">{String(index + 1).padStart(2, '0')}</span>
          <h2>{topic.title}</h2>
          <p>相關文章 · Related writing</p>
          <span class="practice-count">
            {topic.groups.length} notes
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topics-section { padding-bottom: var(--space-section); }
</style>
