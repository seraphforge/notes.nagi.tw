---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicArticleGroups, languageLabel } from '../lib/articles';
import { categoryLabel } from '../lib/categories';

const groups = await getPublicArticleGroups();
const years = [...new Set(groups.map((group) => group.primary.data.date.getFullYear()))];
const monthName = new Intl.DateTimeFormat('en', { month: 'long' });
const languageTags = { zh: 'zh-TW', en: 'en', ja: 'ja' } as const;
---

<BaseLayout title="Archive">
  <header class="container intro">
    <p class="eyebrow">Chronology</p>
    <h1>Archive</h1>
  </header>

  <div class="container archive">
    {years.map((year) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>

        {[...new Set(
          groups
            .filter((group) => group.primary.data.date.getFullYear() === year)
            .map((group) => group.primary.data.date.getMonth()),
        )].map((month) => (
          <section class="archive-month" aria-labelledby={`month-${year}-${month}`}>
            <h3 id={`month-${year}-${month}`}>{monthName.format(new Date(year, month))}</h3>

            <div class="archive-list">
              {groups
                .filter(
                  (group) =>
                    group.primary.data.date.getFullYear() === year &&
                    group.primary.data.date.getMonth() === month,
                )
                .map((group) => (
                  <article class="archive-row" data-language-group data-group-key={group.key}>
                    <time
                      datetime={group.primary.data.date.toISOString().slice(0, 10)}
                    >
                      {group.primary.data.date.getDate().toString().padStart(2, '0')}
                    </time>
                    {group.availableLanguages.map((language) => {
                      const article = group.variants[language]!;
                      const defaultLanguage = group.variants.zh ? 'zh' : group.availableLanguages[0];
                      return <div class="archive-entry" data-language-variant={language} hidden={language !== defaultLanguage}>
                      <a href={article.href} lang={languageTags[article.language]}>
                        {article.data.title}
                      </a>
                      <p>{categoryLabel(article.category, article.language)} <span aria-hidden="true">·</span> <span data-actual-language>{languageLabel[article.language]}</span></p>
                    </div>;
                    })}
                  </article>
                ))}
            </div>
          </section>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .intro { position: relative; padding: clamp(5rem, 10vw, 8.5rem) 0 clamp(3rem, 6vw, 5rem); border-top: 3px solid var(--accent); }
  .intro::after { position: absolute; top: 1rem; right: 0; width: 1rem; height: 1rem; border-top: 1px solid var(--line); border-right: 1px solid var(--line); content: ""; }
  .intro h1 { margin: 0.35rem 0 0; }

  .archive {
    width: min(960px, calc(100% - 40px));
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .archive-year {
    padding: clamp(3rem, 7vw, 6rem) 0 1rem;
    border-top: 1px solid var(--line);
  }

  .archive-year > h2 {
    margin: 0 0 clamp(3rem, 7vw, 5.5rem);
    color: var(--ink);
    font-size: clamp(4rem, 10vw, 7.5rem);
    letter-spacing: -0.055em;
  }

  .archive-month {
    margin: 0 0 clamp(3.5rem, 7vw, 5.5rem);
  }

  .archive-month > h3 {
    margin: 0;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted-readable);
    font-family: var(--sans);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .archive-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: clamp(0.8rem, 2.5vw, 1.5rem);
    align-items: start;
    padding: clamp(1.25rem, 3vw, 1.8rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .archive-row time {
    padding-top: 0.15rem;
    color: var(--muted-readable);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .archive-entry {
    min-width: 0;
  }

  .archive-entry a {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.28;
    text-decoration: none;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .archive-entry a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .archive-entry p {
    margin: 0.4rem 0 0;
    color: var(--muted-readable);
    font-size: 0.78rem;
    line-height: 1.5;
    text-transform: capitalize;
  }

  @media (max-width: 720px) {
    .intro {
      padding-top: 4rem;
    }

    .archive {
      width: min(100% - 32px, 960px);
      padding-bottom: 4rem;
    }

    .archive-year {
      padding-top: 3rem;
    }

    .archive-year > h2 {
      margin-bottom: 3rem;
    }

    .archive-month {
      margin-bottom: 3.5rem;
    }

    .archive-row {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.9rem 0;
    }
  }
</style>
