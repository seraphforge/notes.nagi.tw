---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getPublicArticleGroups } from '../../lib/articles';

const groups = await getPublicArticleGroups();
---

<BaseLayout title="Articles" description="人生經驗、資安、專案，以及目前正在探索的研究。 Life, Security, Projects, and Research.">
  <header class="container page-intro">
    <p class="eyebrow">Publication index · {groups.length} notes</p>
    <h1>Articles</h1>
    <p>人生經驗、資安、專案，以及目前正在探索的研究。<br />Life, Security, Projects, and Research.</p>
  </header>
  <section class="container articles-section">
    <ArticleList groups={groups} filterable />
  </section>
</BaseLayout>

<style>
  .articles-section { padding-bottom: var(--space-section); }
</style>
