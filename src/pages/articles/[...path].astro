---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicArticles, formatDate, languageLabel, languageOrder, type Article } from '../../lib/articles';
import { render } from 'astro:content';
import { categoryLabel } from '../../lib/categories';
import { topicSlug } from '../../lib/topics';

export async function getStaticPaths() {
  const articles = await getPublicArticles();
  return articles.map((article) => ({
    params: { path: `${article.routeSlug}${article.language === 'zh' ? '' : `/${article.language}`}` },
    props: { article, all: articles },
  }));
}

const { article, all } = Astro.props as { article: Article; all: Article[] };
const { Content, headings } = await render(article);
const translations = all
  .filter((candidate) => candidate.key === article.key)
  .sort((a, b) => languageOrder.indexOf(a.language) - languageOrder.indexOf(b.language));
const sameLanguage = all.filter((candidate) => candidate.language === article.language);
const index = sameLanguage.findIndex((candidate) => candidate.id === article.id);
const previous = sameLanguage[index + 1];
const next = sameLanguage[index - 1];
const lang = article.language === 'zh' ? 'zh-TW' : article.language;
const image = article.data.cover ?? article.data.banner;
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={image}
  lang={lang}
  canonical={new URL(article.href, Astro.site)}
  articleLanguage={article.language}
>
  <article class="article container">
    <header>
      <p class="eyebrow">{categoryLabel(article.category, article.language)} · <span data-actual-language>{languageLabel[article.language]}</span></p>
      <h1>{article.data.title}</h1>
      {article.data.description && <p class="deck">{article.data.description}</p>}
      <div class="byline">
        <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date, article.language)}</time>
        <nav aria-label="Translations">
          {translations.map((translation) => (
            <a
              href={translation.href}
              data-article-language-link={translation.language}
              aria-current={translation.id === article.id ? 'page' : undefined}
            >{languageLabel[translation.language]}</a>
          ))}
        </nav>
      </div>
      {image && <img class="cover" src={image} alt="" />}
      <div class="tags">{article.data.tags.map((tag) => <a href={`/topics/${topicSlug(tag)}/`}>#{tag}</a>)}</div>
    </header>
    <div class="reading">
      {headings.length >= 3 && (
        <aside aria-label="Table of contents">
          <details open>
            <summary>On this page</summary>
            <ol>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li class={`d${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </details>
        </aside>
      )}
      <div class="prose"><Content /></div>
    </div>
    <footer class="article-nav">
      <div>{previous && <><span>Previous</span><a href={previous.href}>{previous.data.title}</a></>}</div>
      <a href="/articles/">Back to Articles</a>
      <div>{next && <><span>Next</span><a href={next.href}>{next.data.title}</a></>}</div>
    </footer>
  </article>
</BaseLayout>

<style>
  .article { padding: 5rem 0; }
  .article > header { position: relative; width: min(100%, 54rem); margin: auto; padding-top: 1.5rem; border-top: 3px solid var(--accent); }
  .article > header::after { position: absolute; top: 0.75rem; right: 0; width: 0.55rem; height: 0.55rem; border: 1px solid var(--line); content: ""; }
  .article h1 { margin: 0.6rem 0 1.2rem; font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .deck { color: var(--muted-readable); font-family: var(--serif); font-size: 1.2rem; }
  .byline { display: flex; justify-content: space-between; margin-top: 2rem; padding: 1rem 0; border-top: 1px solid var(--line); font-size: 0.85rem; }
  .byline nav { display: flex; gap: 1rem; }
  .byline a { color: var(--muted-readable); }
  .byline a[aria-current] { color: var(--accent); font-weight: 700; }
  .cover { width: 100%; max-height: 460px; margin: 2rem 0; object-fit: cover; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.7rem; color: var(--muted-readable); font-size: 0.75rem; }
  .reading { display: grid; grid-template-columns: minmax(0, 46rem) 13rem; justify-content: center; gap: 4rem; margin-top: 4rem; }
  .reading aside { grid-column: 2; grid-row: 1; order: 2; color: var(--muted-readable); font-size: 0.75rem; }
  aside ol { padding-left: 1rem; }
  aside .d3 { margin-left: 0.6rem; }
  aside a { color: inherit; }
  .prose { margin: auto; }
  .article-nav { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--line); font-size: 0.85rem; }
  .article-nav div:last-child { text-align: right; }
  .article-nav span { display: block; color: var(--muted-readable); font-size: 0.72rem; }
  .article-nav div a { color: var(--ink); }
  @media (max-width: 950px) {
    .reading { display: block; }
    .reading aside { width: min(100%, 46rem); margin: 0 auto 2rem; }
  }
  @media (max-width: 650px) {
    .article { padding: 3rem 0; }
    .byline { display: block; }
    .byline nav { margin-top: 0.7rem; }
    .article-nav { grid-template-columns: 1fr; }
    .article-nav div:last-child { text-align: left; }
  }
</style>
