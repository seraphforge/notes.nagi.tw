---
import BaseLayout from '../layouts/BaseLayout.astro';
// Publicly documented participation only; exact event dates are not established by these articles.
const events = [
  { name: 'FRC 季後賽', kind: 'Robotics competition', role: '帶隊、賽前維修與團隊協作', article: 'frc-engineering-team' },
  { name: 'InfoSec Taiwan 2026', kind: 'Conference', role: '參訪與產業觀察', article: 'infosec-taiwan-2026-student-industry-gap' },
  { name: '2026 資安大會', kind: 'Conference', role: '參訪與跨領域探索', article: '2026-security-conference' },
];
---
<BaseLayout title="Experience" description="Nagi 參與過的競賽與真實活動。">
  <header class="container page-intro">
    <p class="eyebrow">Competitions &amp; events</p>
    <h1>Experience</h1>
    <p>參與過的競賽與活動。故事留在文章裡，這裡整理參與的足跡。</p>
  </header>
  <section class="container experience" aria-labelledby="year-2026">
    <h2 id="year-2026">2026</h2>
    <p class="muted">依年份整理，年內依相關文章時間由新到舊排列；文章日期不代表活動日期。目前收錄已公開記錄的活動。</p>
    <ol>
      {events.map((event) => <li>
        <p class="eyebrow">{event.kind}</p>
        <h3>{event.name}</h3>
        <p>{event.role}</p>
        <a href={`/articles/${event.article}/`}>閱讀相關文章 →</a>
      </li>)}
    </ol>
  </section>
</BaseLayout>
<style>
  .experience { padding-bottom: var(--space-section); }
  .experience > h2 { margin-top: 0; }
  ol { padding: 0; list-style: none; }
  li { padding: 2rem 0; border-top: 1px solid var(--line); }
  h3 { margin: 0.6rem 0; font-size: clamp(1.7rem, 4vw, 2.6rem); }
</style>
